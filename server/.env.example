# ---- Jervis server configuration -------------------------------------------
PORT=4010
NODE_ENV=development

# Data layer. "memory" uses the bundled synthetic production data set.
# "postgres" selects src/data/adapters/postgres.adapter.js (DB seam).
# "databricks" answers every question with SQL against the configured
# Databricks SQL warehouse (src/data/adapters/databricks.adapter.js).
JERVIS_DATA_SOURCE=memory
DATABASE_URL=

# Narrative generation.
# "deterministic" (default) composes answers from templates - no API calls,
# fully offline, reproducible. "claude" routes the grounded facts through the
# Claude Messages API for the narrative wording only; all numbers still come
# from the retrieval layer.
JERVIS_LLM_PROVIDER=deterministic
JERVIS_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ---- Voice (ElevenLabs text-to-speech) -------------------------------------
# Spoken answers use ElevenLabs when both values are set; the key stays on the
# server and only the generated audio reaches the browser. Set the voice id to
# a Jackie Shroff voice from your ElevenLabs account (a cloned voice, or one you
# are licensed to use). Leave empty to use the browser's own voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Authentication --------------------------------------------------------
# Sessions are server-side; the browser holds only an opaque httpOnly cookie.
# Demo accounts (synthetic data, local prototype only) are shown on the sign-in
# screen as quick-fill buttons:
#   manager@jervis.local  / Manager!2026   (Production manager)
#   engineer@jervis.local / Engineer!2026  (Quality engineer)
#   viewer@jervis.local   / Viewer!2026    (Line viewer)
JERVIS_SESSION_TTL_HOURS=8
JERVIS_SESSION_COOKIE=jervis_session
# Mark the cookie Secure (HTTPS only). Defaults on when NODE_ENV=production.
JERVIS_COOKIE_SECURE=
# The x-jervis-role header shortcut (no password) for local dev and tests.
# Defaults on unless NODE_ENV=production, where only a real session is accepted.
JERVIS_ALLOW_HEADER_ROLE=
JERVIS_LOGIN_MAX_ATTEMPTS=10
JERVIS_LOGIN_WINDOW_MINUTES=5

# ---- Single sign-on (Microsoft Entra ID, OpenID Connect) -------------------
# Off by default; the demo accounts above are the only way in. SSO switches on
# when the provider is "entra" AND tenant id, client id and client secret are
# all set - the sign-in screen then shows "Sign in with Microsoft" next to the
# demo logins. Register a web app in Entra (App registrations) with the
# redirect URI below, and give it the "email" and "profile" optional claims
# and - for role mapping - either the groups claim or app roles.
# See docs/ACCESS-MODEL.md, "SSO (Entra ID)".
JERVIS_SSO_PROVIDER=
# Directory (tenant) id of the Entra tenant. "common" / "organizations" also
# work (multi-tenant registration), the issuer is then checked per token.
JERVIS_SSO_TENANT_ID=
# Application (client) id and a client secret from the app registration.
# The secret also seals the short-lived state cookie used during the flow.
JERVIS_SSO_CLIENT_ID=
JERVIS_SSO_CLIENT_SECRET=
# Where Entra sends the browser back to. The browser reaches the API through
# the UI's proxy (Vite dev server on 5180, nginx on port 80 on the LAN), so
# this is the PUBLIC UI ORIGIN + /api/auth/sso/callback - never the API port -
# and the same value must be registered on the Entra app, character for
# character. Examples: http://127.0.0.1:5180/api/auth/sso/callback (dev),
# http://jervis.plant.local/api/auth/sso/callback (LAN).
JERVIS_SSO_REDIRECT_URI=http://127.0.0.1:5180/api/auth/sso/callback
# Role mapping: a JSON object from Entra group object ids (groups claim) or
# app role values (roles claim) to a Jervis role (manager | engineer | viewer).
# A user in several mapped groups gets the most privileged one. Example:
#   {"0f1e2d3c-…":"manager","Jervis.Engineer":"engineer","Jervis.Viewer":"viewer"}
JERVIS_SSO_ROLE_MAP=
# Role for a signed-in user whose groups/roles match nothing in the map.
JERVIS_SSO_DEFAULT_ROLE=viewer
# Optional comma-separated allow-list of email domains. When set, a user whose
# email (or UPN) is not on one of these domains is refused (sso_error=domain).
JERVIS_SSO_ALLOWED_DOMAINS=

# Connector endpoints. Empty values keep the mock connectors active, which is
# what the prototype runs on until the client grants controlled access. Any of
# these can also be set at runtime from the Integrations page, which writes to
# server/data/integrations.json; saved values win over the env.
#
# A connector goes "live" only when its required fields are set AND it has been
# enabled on the Integrations page.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=prod_quality
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
POWERBI_MEASURES_DAX=
INTEGRAL_PORTAL_BASE_URL=
INTEGRAL_PORTAL_API_KEY=
INTEGRAL_PORTAL_TICKETS_PATH=/api/tickets
INTEGRAL_PORTAL_HEALTH_PATH=/health
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=plant1/+/+/state
LEGACY_CHATBOT_URL=

# ---- Microsoft 365 (mail and calendar for the secretary module) ------------
# App registration with Mail.Read, Mail.Send and Calendars.Read application
# permissions, scoped to one mailbox with an Exchange application access
# policy. Empty values keep the synthetic mailbox active and replies simulated;
# live mode also needs the connector enabled on the Integrations page, after
# which inbox, calendar and (confirmed) replies go to Microsoft Graph
# (see server/src/connectors/microsoft365.connector.js).
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_MAILBOX=
# Optional. Windows or IANA time zone of the mailbox, used for the calendar
# day window and the Prefer: outlook.timezone header.
MS365_TIMEZONE=W. Europe Standard Time

# ---- Power Automate ---------------------------------------------------------
# Outbound: the HTTP-trigger URL of an approved flow (it carries the
# signature, so it is a secret). A flow is only ever started after the user
# confirms; without a URL (or with the connector disabled) triggers are
# simulated and only recorded in the audit trail. The optional catalog lists
# the flows Jervis may start, each with its own url if it differs from the
# default: [{ "name": "escalate-quality-issue", "label": "Escalate a quality issue", "url": "https://..." }]
# Inbound: flows that ask Jervis a question call POST /api/automate/inbound
# with the shared secret in the x-jervis-automate-secret header; the endpoint
# stays disabled (503) while the secret is empty.
POWER_AUTOMATE_TRIGGER_URL=
POWER_AUTOMATE_INBOUND_SECRET=
POWER_AUTOMATE_FLOWS=

# ---- Secretary and dashboard stores ---------------------------------------
# Tasks/reminders and on-request dashboards are kept in memory and persisted
# to these JSON files (local state, not committed). A missing file is normal:
# the seed is used and the file appears on the first write. Override the
# paths to relocate them, e.g. for tests.
JERVIS_TASKS_FILE=
JERVIS_DASHBOARDS_FILE=

# Speech-to-text (push-to-talk fallback, POST /api/voice/stt) reuses
# ELEVENLABS_API_KEY above with the scribe_v1 model; no extra setting needed.
